{
  "name": "@weavenyc/notifications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "description": "M7 notifications runtime for internal SMS and email delivery.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../.. exec vitest run services/notifications/test/"
  },
  "dependencies": {
    "@fastify/jwt": "^9.1.0",
    "@sentry/node": "^10.49.0",
    "@weavenyc/shared": "workspace:*",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vitest": "^2.1.8"
  }
}
