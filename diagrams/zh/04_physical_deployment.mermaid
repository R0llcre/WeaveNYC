  style MATCH fill:#FFCC80,stroke:#EF6C00
  style POSTS fill:#FFCC80,stroke:#EF6C00
  style CHAT fill:#FFCC80,stroke:#EF6C00
  style RDS fill:#FFE082,stroke:#F57F17
  style REDIS fill:#FFE082,stroke:#F57F17
  style S3 fill:#FFE082,stroke:#F57F17
  style CR fill:#A5D6A7,stroke:#2E7D32
  style GCS fill:#C8E6C9,stroke:#388E3C
  style NOTIF fill:#90CAF9,stroke:#1565C0
  style SPEECH fill:#90CAF9,stroke:#1565C0
