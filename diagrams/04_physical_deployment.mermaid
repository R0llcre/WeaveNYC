%% WeaveNYC — Physical Deployment: 多云部署拓扑
%% Source: 06_Blueprints.md §2.3 + 19_Deployment_Guide.md §2

flowchart LR
  subgraph Edge ["Edge（PWA + libp2p WebWorker）"]
    U1[User PWA<br/>IndexedDB + Helia]
    U2[User PWA<br/>IndexedDB + Helia]
  end

  subgraph Anchor ["Anchor（libp2p Full Node）"]
    AN[Anchor Node<br/>Fastify + GossipSub<br/>+ Helia Pin]
    AC[Admin Console<br/>Next.js]
  end

  subgraph AWS ["AWS"]
    APIGW[Lambda<br/>API Gateway]
    MATCH[Lambda<br/>Match Engine]
    POSTS[Lambda<br/>Posts Service]
    CHAT[ECS Fargate<br/>Chat WebSocket]
    RDS[(RDS PostgreSQL<br/>+ PostGIS)]
    REDIS[ElastiCache<br/>Redis]
    S3[(S3 Backups)]
  end

  subgraph GCP ["GCP"]
    CR[Cloud Run<br/>Resource Directory]
    GCS[(Cloud Storage)]
  end

  subgraph Azure ["Azure"]
    NOTIF[Functions<br/>Notification]
    SPEECH[Functions<br/>Speech Gateway]
  end

  subgraph CFPages ["Cloudflare Pages"]
    PWA[weavenyc-pwa<br/>PWA Frontend]
    ADMV[weavenyc-anchor-admin<br/>Admin Console]
  end

  U1 <-->|"WebRTC P2P"| U2
  U1 <-->|WebSocket| AN
  U2 <-->|WebSocket| AN
  AC <-->|HTTPS| AN

  AN <-->|REST| APIGW
  APIGW --> MATCH
  APIGW --> POSTS
  APIGW --> CHAT
  MATCH <--> RDS
  POSTS <--> RDS
  CHAT <--> REDIS
  APIGW <--> REDIS
  MATCH --> NOTIF
  MATCH --> S3
  CR --> GCS
  CR --> RDS

