%% WeaveNYC — Post Lifecycle State Machine
%% Source: 08_Data_Model.md §2.5 + 09_API_Spec.md §3

stateDiagram-v2
    [*] --> draft : User starts editing

    draft --> pending_review : Submit post

    pending_review --> active : Anchor approves OR auto-pass for low risk
    pending_review --> removed : Anchor rejects

    active --> fulfilled : Both parties confirm completion
    active --> closed : Owner closes OR auto-expire 24h
    active --> removed : Anchor takes down after report

    fulfilled --> [*]
    closed --> [*]
    removed --> [*]

    state draft {
        [*] --> editing
        editing : IndexedDB local storage
        editing : User can edit multiple times
    }

    state pending_review {
        [*] --> in_queue
        in_queue : High-risk categories forced review
        in_queue : Low-risk auto-approve
    }

    state active {
        [*] --> matchable
        matchable : Synced to P2P network
        matchable : Enters match engine pool
        matchable : Default TTL 24h
    }

    state fulfilled {
        [*] --> verified
        verified : Triggers reputation
        verified : verified_by_witnesses
    }
