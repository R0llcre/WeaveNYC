%% WeaveNYC — To-Be Logical: 服务与数据流（不绑定云厂商）
%% Source: 06_Blueprints.md §2.2

flowchart TB
  UI[Mobile / PWA<br/>用户界面] --> LS[Local Store<br/>本地存储]
  UI -->|create post| APIGW[Anchor API<br/>社区网关]
  APIGW --> MOD[Moderation Queue<br/>审核队列]
  APIGW --> IDX[Community Index<br/>社区索引]
  IDX --> MATCH[Match Engine<br/>匹配引擎]
  MATCH --> APIGW
  APIGW --> UI

  ING[Directory Ingestion<br/>目录导入服务] --> DIR[(Directory DB<br/>官方资源库)]
  DIR --> MATCH

  UI -->|report| REP[Report Service<br/>举报服务]
  REP --> MOD

  style UI fill:#FFE0B2,stroke:#E65100
  style LS fill:#FFF9C4,stroke:#F9A825
  style APIGW fill:#CE93D8,stroke:#6A1B9A
  style MOD fill:#EF9A9A,stroke:#C62828
  style IDX fill:#A5D6A7,stroke:#2E7D32
  style MATCH fill:#90CAF9,stroke:#1565C0
  style ING fill:#B0BEC5,stroke:#37474F
  style DIR fill:#B0BEC5,stroke:#37474F
  style REP fill:#EF9A9A,stroke:#C62828
