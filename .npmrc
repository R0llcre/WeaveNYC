ignore-workspace-root-check=true

# EAS Build's `pnpm install` fails to bundle iOS because Metro tries to
# resolve transitives like `@babel/runtime/helpers/interopRequireDefault`
# and `@expo/metro-runtime` from *inside other packages* (expo,
# react-native, expo-router). pnpm's strict symlink layout hides them.
# Hoisting every React Native / Expo / Babel helper to the top-level
# node_modules gives Metro the flat resolution it expects — same shape
# as npm/yarn would produce. Scoped lists keep non-mobile workspaces
# (packages/*, services/*, apps/pwa, apps/anchor-admin) unaffected.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=@shopify*
public-hoist-pattern[]=@sentry*
public-hoist-pattern[]=@expo*
