ignore-workspace-root-check=true

# EAS Build (and any pnpm install inside apps/mobile) needs a flat
# node_modules so Metro can resolve transitives like `invariant`,
# `@babel/runtime`, and `@expo/metro-runtime` from inside react-native /
# expo / expo-router. pnpm's strict-isolation symlink layout hides them
# under .pnpm/<hash>/node_modules. shamefully-hoist promotes every
# transitive to the top level — the same shape npm/yarn would produce —
# and is the Expo-docs-recommended fix for pnpm monorepos on EAS.
# Mobile-only config was tried first; pnpm ignores workspace-level
# .npmrc for node-linker, so we have to opt in at root.
shamefully-hoist=true
