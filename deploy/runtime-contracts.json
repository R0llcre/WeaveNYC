{
  "schemaVersion": 1,
  "topology": "http-first-staging-rehearsal",
  "runtimes": [
    {
      "name": "api-gateway",
      "class": "current",
      "package": "@weavenyc/api-gateway",
      "workspace": "services/api-gateway",
      "provider": "aws",
      "artifactPath": "services/api-gateway/dist/src/server.js",
      "buildCommand": "pnpm --filter @weavenyc/api-gateway build",
      "serveCommand": "pnpm --filter @weavenyc/api-gateway start",
      "smokeUrlEnv": "WEAVENYC_STAGING_API_GATEWAY_URL",
      "healthPaths": [
        "/healthz",
        "/readyz",
        "/versionz",
        "/docs"
      ],
      "repoPresenceRequired": true
    },
    {
      "name": "posts-service",
      "class": "current",
      "package": "@weavenyc/posts",
