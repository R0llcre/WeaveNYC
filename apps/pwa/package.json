{
  "name": "@weavenyc/pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @weavenyc/shared build",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "prebuild": "pnpm --filter @weavenyc/shared build",
    "build": "next build",
    "lint": "eslint src --ext .ts,.tsx",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "test": "cd ../.. && vitest run apps/pwa",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.11.2",
    "@sentry/nextjs": "^10.49.0",
    "@tanstack/react-query": "5.96.2",
    "@weavenyc/shared": "workspace:*",
    "dexie": "^4.2.1",
    "framer-motion": "^12.38.0",
    "next": "16.2.2",
    "next-intl": "^4.5.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.11.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3"
  }
}
