{
  "name": "@weavenyc/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "predev": "pnpm --filter @weavenyc/shared build",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --passWithNoTests",
    "prebuild:ios": "expo prebuild --no-install --platform ios",
    "eas-build-pre-install": "echo \"EAS pre-install: pinning CocoaPods 1.15.2 to avoid pathname-null-byte bug in 1.16.2 with pnpm monorepo\" && sudo gem install -n /Users/expo/.gems/arm64/bin cocoapods -v 1.15.2 --no-document || gem install --user-install cocoapods -v 1.15.2 --no-document || echo \"(gem install failed but may be pre-installed)\""
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/metro-runtime": "^4.0.1",
    "@expo/vector-icons": "^14.0.4",
    "@hookform/resolvers": "^3.9.0",
    "@reduxjs/toolkit": "2.11.2",
    "@sentry-internal/browser-utils": "^10.49.0",
    "@sentry-internal/feedback": "^10.49.0",
    "@sentry-internal/replay": "^10.49.0",
    "@sentry-internal/replay-canvas": "^10.49.0",
    "@sentry/browser": "^10.49.0",
    "@sentry/core": "^10.49.0",
    "@sentry/react-native": "^8.9.1",
    "@shopify/restyle": "^2.4.5",
    "@tanstack/react-query": "5.99.2",
    "@weavenyc/shared": "workspace:*",
    "expo": "~52.0.0",
    "expo-av": "~15.0.0",
    "expo-build-properties": "~0.13.0",
    "expo-camera": "~16.0.0",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-contacts": "~14.0.0",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-localization": "16.0.1",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-speech": "~13.0.0",
