{
  "expo": {
    "name": "WeaveNYC",
    "slug": "weavenyc",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "weavenyc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "org.weavenyc.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:weavenyc.org"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "WeaveNYC uses the camera to scan QR codes for verified anchors and to attach photos to posts.",
        "NSMicrophoneUsageDescription": "WeaveNYC uses the microphone to record short voice notes for posts and chat.",
        "NSLocationWhenInUseUsageDescription": "WeaveNYC uses your location to show nearby resources like food pantries, clinics, and housing help.",
        "NSPhotoLibraryUsageDescription": "WeaveNYC uses your photo library to let you attach images to posts.",
        "NSContactsUsageDescription": "WeaveNYC can add trusted neighbors to your contacts, with your permission.",
        "NSFaceIDUsageDescription": "WeaveNYC can use Face ID to lock your verified session."
      }
    },
    "android": {
      "package": "org.weavenyc.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      "expo-camera",
      "expo-local-authentication",
      "expo-contacts",
      "expo-av",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static"
          }
        }
      ],
      "@sentry/react-native",
      "expo-sqlite",
      "./plugins/with-complete-ios-icon.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e010a495-e484-4d3c-994a-fb7a21007f67"
      }
    },
    "owner": "r0llcre"
  }
}
