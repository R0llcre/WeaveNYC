NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
PWA_PORT=3000
NOTIFICATIONS_PORT=4105
PWA_BASE_URL=http://localhost:3000
NOTIFICATIONS_DEMO_BASE_URL=http://localhost:3000
ANCHOR_ADMIN_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
DATABASE_URL=postgres://weavenyc:weavenyc@localhost:5432/weavenyc_dev
REDIS_URL=redis://localhost:6379
JWT_SIGNING_PRIVATE_KEY=./infra/dev/jwt-private.pem
JWT_SIGNING_PUBLIC_KEY=./infra/dev/jwt-public.pem
INTERNAL_SERVICE_JWT_SECRET=weavenyc-dev-internal-service-jwt-secret
NOTIFICATIONS_INTERNAL_JWT_SECRET=
P2P_MDNS_DEMO_ENABLED=0
NEXT_PUBLIC_P2P_MDNS_DEMO_ENABLED=0
# Account-purge worker. Defaults to enabled in staging/production and disabled
# locally/in tests. Override with 1/0 when you need a different cadence.
ENABLE_PURGE_JOB=
PURGE_JOB_CRON=
# Comma-separated CORS origin patterns. Supports `*` wildcard (e.g. "http://localhost:*,https://*.weavenyc.org").
# If unset: development/test fall back to http://localhost:* + http://127.0.0.1:*; staging/production must set this explicitly.
ALLOWED_CORS_ORIGINS=
POSTS_SERVICE_URL=
MATCH_SERVICE_URL=
CHAT_SERVICE_URL=
RESOURCE_DIRECTORY_SERVICE_URL=
NOTIFICATIONS_SERVICE_URL=
# Development/test only. Production must set this explicitly.
IDENTITY_HASH_PEPPER=weavenyc-dev-identity-pepper
# Development/test only. Production must set this explicitly.
ANCHOR_TOTP_ENCRYPTION_KEY=weavenyc-dev-anchor-totp-encryption-key
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Sentry DSNs per deployment target. All are optional in development/test —
# when empty the SDK is a no-op. Set SENTRY_DSN on the api-gateway /
# resource-directory / notifications containers, and the NEXT_PUBLIC_*
# variants on the Cloudflare Pages env for pwa + anchor-admin.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
